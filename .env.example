# Local mode needs none of these: build the app and paste your AI Gateway key
# in Settings. Fill this file only for hosted mode (see README).

# --- API (services/api) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
# Optional on Vercel; deployed functions use Vercel OIDC.
AI_GATEWAY_API_KEY=
AI_DIAGNOSTICS=off

# --- Desktop app (apps/desktop) ---
# Setting any of these selects hosted mode; then all are required.
# Read at run time and baked in at build time. Public values only.
AUTOCOMPLETION_API_URL=
AUTOCOMPLETION_CLERK_AUTHORIZATION_URL=
AUTOCOMPLETION_CLERK_TOKEN_URL=
AUTOCOMPLETION_CLERK_USERINFO_URL=
AUTOCOMPLETION_CLERK_REVOCATION_URL=
AUTOCOMPLETION_CLERK_CLIENT_ID=
AUTOCOMPLETION_ACCOUNT_URL=
# Optional.
AUTOCOMPLETION_CLERK_REDIRECT_URI=http://127.0.0.1:43119/callback
AUTOCOMPLETION_CLIPBOARD_CONTEXT=0
